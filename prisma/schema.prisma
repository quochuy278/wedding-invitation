generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  full_name     String
  phone_number  String?     @unique
  email         String      @unique
  level         Int         @default(1)
  password_hash String?
  created_at    DateTime    @default(now()) @db.Timestamptz(3)
  updated_at    DateTime    @updatedAt @db.Timestamptz(3)
  deleted_at    DateTime?   @db.Timestamptz(3)
  invitation    Invitation?
  sessions      Session[]

  @@map("users")
}

model Session {
  id                 String    @id @default(cuid())
  user_id            String
  refresh_token_hash String
  expires_at         DateTime  @db.Timestamptz(3)
  revoked_at         DateTime? @db.Timestamptz(3)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)
  user               User      @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Address {
  id              String       @id @default(cuid())
  name            String
  address_text    String
  address_line_1  String?
  address_line_2  String?
  location_type   String?
  postal_code     String?
  city            String?
  region          String?
  country         String?
  instructions    String?
  floor           String?
  entrance        String?
  latitude        Float?
  longitude       Float?
  event_at        DateTime     @db.Timestamptz(3)
  event_time_zone String?
  created_at      DateTime     @default(now()) @db.Timestamptz(3)
  updated_at      DateTime     @updatedAt @db.Timestamptz(3)
  invitations     Invitation[]

  @@map("addresses")
}

model Invitation {
  id               String    @id @default(cuid())
  code             String    @unique @default(cuid())
  user_id          String    @unique
  address_id       String
  status           String
  guest_count      Int       @default(1)
  personal_message String?
  created_at       DateTime  @default(now()) @db.Timestamptz(3)
  updated_at       DateTime  @updatedAt @db.Timestamptz(3)
  expires_at       DateTime  @db.Timestamptz(3)
  deleted_at       DateTime? @db.Timestamptz(3)
  user             User      @relation(fields: [user_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  address          Address   @relation(fields: [address_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  wishes           Wish[]

  @@index([address_id])
  @@map("invitations")
}

model Wish {
  id            String     @id @default(cuid())
  invitation_id String
  content       String
  created_at    DateTime   @default(now()) @db.Timestamptz(3)
  updated_at    DateTime   @updatedAt @db.Timestamptz(3)
  invitation    Invitation @relation(fields: [invitation_id], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@index([invitation_id])
  @@map("wishes")
}
