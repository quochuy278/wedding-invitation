# Browser API base URL. Defaults to this application's Next.js API routes.
NEXT_PUBLIC_API_BASE_URL="/api"

# Server-only JWT signing key: generate with pnpm auth:setup for local development.
AUTH_SECRET=""
# Exact browser origin allowed to perform login, refresh and logout (HTTPS in production).
AUTH_ORIGIN="http://localhost:3000"
# Optional single-value IP header overwritten by your trusted deployment proxy.
# Leave empty if unsure; the local burst limiter will use a shared bucket.
TRUSTED_CLIENT_IP_HEADER=""

# Runtime: shared transaction-mode pooler for serverless deployments.
DATABASE_URL="postgresql://postgres.plhydlyvfrhwrwajvcgy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI and migrations: shared session-mode pooler.
DIRECT_URL="postgresql://postgres.plhydlyvfrhwrwajvcgy:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
